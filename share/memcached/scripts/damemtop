# Bash adaptation of Dormando's BSD-licensed cluster statistics utility.
# Supports the shipped block-style YAML configuration; YAML is never executed.
function damemtop_main() (
    local config="" once=false delay=3 sort_column=hostname sort_order=asc mode=t no_clear=false area="" list="" line value key endpoint work now previous_time=0 elapsed=1 column
    local servers=() columns=()
    case "${1:-}" in -h | --help)
        cat <<'HELP'
Usage: damemtop [--config FILE] [--once]
Reads ~/.damemtop/damemtop.yaml, /etc/damemtop.yaml or the bundled default.
Block YAML supports delay, mode, no_clear, servers and top_mode
(sort_column, sort_order, columns). Keys: q quits; h/? shows help; t shows stats.
Columns from stats/items/slabs are rates per second; all_ selects absolute values.
hostname, hit_rate and fill_rate are computed. --once is suitable for scripts.
HELP
        return 0
        ;;
    esac
    while [[ $# -gt 0 ]]; do
        case "$1" in --config)
            [[ $# -ge 2 ]] || return 1
            config="$2"
            shift
            ;;
        --once) once=true ;; *) return 1 ;;
        esac
        shift
    done
    if [[ -z "$config" ]]; then
        if [[ -f "$HOME/.damemtop/damemtop.yaml" ]]; then
            config="$HOME/.damemtop/damemtop.yaml"
        elif [[ -f /etc/damemtop.yaml ]]; then
            config=/etc/damemtop.yaml
        else config="$(dirname "${BASH_SOURCE[0]}")/damemtop.yaml"; fi
    fi
    # shellcheck source=share/memcached/scripts/config.bash
    . "$(dirname "${BASH_SOURCE[0]}")/config.bash" || return 1
    # shellcheck source=share/memcached/scripts/client.bash
    . "$(dirname "${BASH_SOURCE[0]}")/client.bash" || return 1
    [[ -f "$config" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        memcached_words "$line" || return 1
        [[ ${#words[@]} != 0 ]] || continue
        value="${words[*]}"
        case "$value" in
            top_mode:) area=top_mode list="" ;;
            servers:) area=servers list=servers ;;
            columns:)
                [[ "$area" == top_mode ]] || return 1
                list=columns
                ;;
            '- '*)
                [[ ${#words[@]} == 2 ]] || return 1
                if [[ "$list" == servers ]]; then
                    servers+=("${words[1]}")
                elif [[ "$list" == columns ]]; then
                    columns+=("${words[1]}")
                else return 1; fi
                ;;
            delay:*)
                [[ ${#words[@]} == 2 && "${words[1]}" =~ ^[1-9][0-9]*$ ]] || return 1
                delay="${words[1]}"
                ;;
            sort_column:*)
                [[ ${#words[@]} == 2 ]] || return 1
                sort_column="${words[1]}"
                ;;
            sort_order:*)
                [[ ${#words[@]} == 2 && ("${words[1]}" == asc || "${words[1]}" == desc) ]] || return 1
                sort_order="${words[1]}"
                ;;
            mode:*)
                [[ ${#words[@]} == 2 && "${words[1]}" == [th?] ]] || return 1
                mode="${words[1]}"
                ;;
            no_clear:*)
                [[ ${#words[@]} == 2 && ("${words[1]}" == true || "${words[1]}" == false) ]] || return 1
                no_clear="${words[1]}"
                ;;
            *)
                echo 'Unsupported damemtop YAML; use the shipped block-style configuration.' >&2
                return 1
                ;;
        esac
    done <"$config"
    ((${#servers[@]} > 0 && ${#columns[@]} > 0)) || return 1
    for column in "${columns[@]}"; do [[ "$column" =~ ^[A-Za-z0-9_:]+$ ]] || return 1; done
    [[ "$sort_column" =~ ^[A-Za-z0-9_:]+$ ]] || return 1
    work=$(mktemp -d) || return 1
    trap 'rm -rf -- "$work"' EXIT
    : >"$work/previous"
    while :; do
        : >"$work/current"
        for endpoint in "${servers[@]}"; do
            # One slow endpoint cannot indefinitely block the cluster display.
            # shellcheck disable=SC2016 # Fixed child program; inputs are positional data.
            if timeout 10 bash -c '. "$1"; for query in stats "stats items" "stats slabs"; do memcached_query "$2" "$query" || exit; done' \
                _ "$(dirname "${BASH_SOURCE[0]}")/client.bash" "$endpoint" >"$work/response" 2>/dev/null; then
                LEMPER_MEMCACHED_HOST="$endpoint" awk '$1=="STAT" {key=$2; sub(/^items:/,"",key); print ENVIRON["LEMPER_MEMCACHED_HOST"] "\t" key "\t" $3}' "$work/response" >>"$work/current"
            else printf '%s\tstatus\tunavailable\n' "$endpoint" >>"$work/current"; fi
        done
        now=$(date +%s)
        ((previous_time == 0)) || elapsed=$((now - previous_time))
        ((elapsed > 0)) || elapsed=1
        if [[ "$no_clear" == false && -t 1 && "$once" == false ]]; then printf '\033[H\033[2J'; fi
        if [[ "$mode" == t ]]; then
            # Data files and ENVIRON keep addresses/column names literal.
            LEMPER_MEMCACHED_COLUMNS="${columns[*]}" LEMPER_MEMCACHED_SORT="$sort_column" LEMPER_MEMCACHED_ORDER="$sort_order" \
                awk -v elapsed="$elapsed" '
                FILENAME==ARGV[1] {old[$1,$2]=$3; next}
                {current[$1,$2]=$3; hosts[$1]=1}
                function stat(host,key,absolute, value) {
                    if(!((host SUBSEP key) in current)) return "NA"
                    value=current[host,key]
                    if(absolute) return value
                    if(!((host SUBSEP key) in old) || value !~ /^-?[0-9]+([.][0-9]+)?$/ || old[host,key] !~ /^-?[0-9]+([.][0-9]+)?$/) return "NA"
                    return (value-old[host,key])/elapsed
                }
                function compute(host,key, absolute,a,b) {
                    absolute=sub(/^all_/,"",key)
                    if(key=="hostname") return host
                    if(key=="hit_rate") {a=stat(host,"get_hits",absolute); b=stat(host,"get_misses",absolute); return (a=="NA"||b=="NA"||a+b==0?"NA":sprintf("%.1f%%",100*a/(a+b)))}
                    if(key=="fill_rate") {a=stat(host,"bytes",absolute); b=stat(host,"limit_maxbytes",absolute); return (a=="NA"||b=="NA"||b==0?"NA":sprintf("%.1f%%",100*a/b))}
                    return stat(host,key,absolute)
                }
                END {
                    n=split(ENVIRON["LEMPER_MEMCACHED_COLUMNS"],columns," ")
                    for(i=1;i<=n;i++) printf "%-20s",columns[i]; print ""
                    for(host in hosts) {
                        rows[++count]=host
                        for(i=1;i<=n;i++) data[host,i]=compute(host,columns[i])
                        keys[host]=compute(host,ENVIRON["LEMPER_MEMCACHED_SORT"])
                    }
                    for(i=1;i<=count;i++) for(j=i+1;j<=count;j++) {
                        a=keys[rows[i]]; b=keys[rows[j]]
                        sub(/%$/,"",a); sub(/%$/,"",b)
                        swap=(a ~ /^-?[0-9]+([.][0-9]+)?$/ && b ~ /^-?[0-9]+([.][0-9]+)?$/ ? a+0>b+0 : a>b)
                        if(ENVIRON["LEMPER_MEMCACHED_ORDER"]=="desc") swap=!swap
                        if(swap) {temp=rows[i]; rows[i]=rows[j]; rows[j]=temp}
                    }
                    for(j=1;j<=count;j++) {
                        for(i=1;i<=n;i++) {
                            value=data[rows[j],i]; printf "%-20s",value
                            if(value ~ /^-?[0-9]+([.][0-9]+)?$/) {totals[i]+=value; samples[i]++}
                        }
                        print ""
                    }
                    printf "%-20s","<AVERAGE>"
                    for(i=2;i<=n;i++) printf "%-20s",(samples[i]?sprintf("%.2f",totals[i]/samples[i]):"NA")
                    print ""
                    printf "%-20s","<TOTAL>"
                    for(i=2;i<=n;i++) printf "%-20s",(samples[i]?totals[i]:"NA")
                    print ""
                }
            ' "$work/previous" "$work/current"
        else printf 'q: quit; t: statistics; h/?: help. Absolute stats use all_; other numeric stats show per-second changes.\n'; fi
        cp "$work/current" "$work/previous" || return 1
        previous_time="$now"
        [[ "$once" == false ]] || return 0
        key=""
        if [[ -t 0 ]]; then
            IFS= read -r -s -n1 -t "$delay" key || true
        else sleep "$delay"; fi
        case "$key" in q) return 0 ;; t | h | '?') mode="$key" ;; esac
    done
)
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then damemtop_main "$@"; fi
