# Foreground wrapper: systemd tracks the actual memcached process.
function memcached_systemd_main() {
    [[ "$EUID" == 0 && $# -le 1 ]] || return 1
    local parameters=() words=() logfile
    # shellcheck source=share/memcached/scripts/config.bash
    . "$(dirname "${BASH_SOURCE[0]}")/config.bash" || return 1
    memcached_config "${1:-/etc/memcached.conf}" || return 1
    exec /usr/bin/memcached "${parameters[@]}"
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then memcached_systemd_main "$@"; fi
