# Bash adaptation of Brad Fitzpatrick's public-domain memcached-tool.
# shellcheck disable=SC2031 # Response subshells use inherited FDs; parent connection variables stay unchanged.
function memcached_tool_main() (
    local address="${1:-}" mode="${2:-display}" items slabs line key value bucket expiration flags size response from to
    local memcached_in="" memcached_out="" memcached_pid="" buckets=() counts=() keys=() expirations=()
    case "$mode" in stats | settings | sizes | display | dump) [[ $# -le 2 ]] || return 1 ;;
    move) [[ $# == 4 && "$3" =~ ^[0-9]+$ && "$4" =~ ^[0-9]+$ ]] || return 1 ;;
    *)
        echo 'Usage: memcached-tool <host[:port]|socket> [display|stats|settings|sizes|dump|move FROM TO]' >&2
        return 1
        ;;
    esac
    [[ -n "$address" ]] || return 1
    # shellcheck source=share/memcached/scripts/client.bash
    . "$(dirname "${BASH_SOURCE[0]}")/client.bash" || return 1
    trap memcached_disconnect EXIT
    memcached_connect "$address" || return 1
    case "$mode" in
        stats | settings | sizes)
            response=$(memcached_request "stats $([[ "$mode" != stats ]] && printf '%s' "$mode")") || return 1
            printf '#%-17s %5s %11s\n' "$address" Field Value
            awk '$1=="STAT" {printf "%24s %12s\n",$2,$3}' <<<"$response" | sort
            ;;
        display)
            items=$(memcached_request 'stats items') && slabs=$(memcached_request 'stats slabs') || return 1
            printf '  #  Item_Size  Max_age   Pages   Count   Full?  Evicted Evict_Time OOM\n'
            printf '%s\n%s\n' "$items" "$slabs" | awk '
                $1=="STAT" {
                    key=$2; sub(/^items:/,"",key); split(key,p,":"); v[p[1],p[2]]=$3; classes[p[1]]=1
                }
                END {for (n in classes) if(v[n,"total_pages"]+0>0) {
                    size=v[n,"chunk_size"]; rendered=(size<1024?sprintf("%dB",size):sprintf("%.1fK",size/1024))
                    printf "%3d %8s %9ds %7d %7d %7s %8d %8d %4d\n",n,rendered,v[n,"age"],v[n,"total_pages"],v[n,"number"],(v[n,"used_chunks"]==v[n,"total_chunks"]?"yes":"no"),v[n,"evicted"],v[n,"evicted_time"],v[n,"outofmemory"]
                }}
            ' | sort -n
            ;;
        move)
            from="$3" to="$4"
            ((from >= 6 && from <= 17 && to >= 6 && to <= 17)) || return 1
            printf 'slabs reassign %s %s\r\n' "$from" "$to" >&"$memcached_in"
            IFS= read -r -t 10 line <&"$memcached_out" && [[ "${line%$'\r'}" == OK ]]
            ;;
        dump)
            response=$(memcached_request 'stats items') || return 1
            while IFS= read -r line; do
                if [[ "$line" =~ ^STAT[[:space:]]items:([0-9]+):number[[:space:]]([0-9]+)$ ]]; then
                    buckets+=("${BASH_REMATCH[1]}") counts+=("${BASH_REMATCH[2]}")
                fi
            done <<<"$response"
            for bucket in "${!buckets[@]}"; do
                response=$(memcached_request "stats cachedump ${buckets[bucket]} ${counts[bucket]}") || return 1
                keys=() expirations=()
                while IFS= read -r line; do
                    if [[ "$line" =~ ^ITEM[[:space:]]([^[:space:]]+)[[:space:]]\[.*[[:space:]]([0-9]+)[[:space:]]s\]$ ]]; then
                        keys+=("${BASH_REMATCH[1]}") expirations+=("${BASH_REMATCH[2]}")
                    fi
                done <<<"$response"
                for key in "${!keys[@]}"; do
                    value="${keys[key]}" expiration="${expirations[key]}"
                    [[ ! "$value" =~ [[:cntrl:]] && ${#value} -le 250 ]] || return 1
                    printf 'get %s\r\n' "$value" >&"$memcached_in" || return 1
                    IFS= read -r -t 10 line <&"$memcached_out" || return 1
                    line="${line%$'\r'}"
                    [[ "$line" != END ]] || continue # Key disappeared during the dump.
                    [[ "$line" =~ ^VALUE[[:space:]]([^[:space:]]+)[[:space:]]([0-9]+)[[:space:]]([0-9]+)$ ]] || return 1
                    flags="${BASH_REMATCH[2]}" size="${BASH_REMATCH[3]}"
                    [[ "${BASH_REMATCH[1]}" == "$value" ]] || return 1
                    printf 'add %s %s %s %s\r\n' "$value" "$flags" "$expiration" "$size"
                    timeout 10 dd bs=65536 iflag=count_bytes,fullblock count="$size" status=none <&"$memcached_out" || return 1
                    printf '\r\n'
                    IFS= read -r -t 10 line <&"$memcached_out" && [[ "$line" == $'\r' ]] || return 1
                    IFS= read -r -t 10 line <&"$memcached_out" && [[ "${line%$'\r'}" == END ]] || return 1
                done
            done
            ;;
    esac
)
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then memcached_tool_main "$@"; fi
