# Compatibility daemon launcher. start-stop-daemon records the PID before
# memcached drops privileges, avoiding an unprivileged write to /run.
function memcached_start_main() {
    [[ "$EUID" == 0 && ($# == 0 || $# == 2) ]] || return 1
    local file="${1:-/etc/memcached.conf}" pidfile="${2:-/var/run/memcached.pid}" logfile
    local parameters=() words=()
    [[ "$pidfile" == /* && ! -L "$pidfile" ]] || return 1
    # shellcheck source=share/memcached/scripts/config.bash
    . "$(dirname "${BASH_SOURCE[0]}")/config.bash" || return 1
    memcached_config "$file" || return 1
    [[ ! -L "$logfile" ]] || return 1
    start-stop-daemon --start --quiet --oknodo --background --no-close --make-pidfile \
        --pidfile "$pidfile" --exec /usr/bin/memcached -- "${parameters[@]}" \
        </dev/null >>"$logfile" 2>&1
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then memcached_start_main "$@"; fi
