# Bash adaptation of Debian's wrapper by Stefan Hornburg (Racke),
# copyright 2002-2019; original GPL-2.0-or-later terms are retained.
function pure_wrapper_value() {
    local file="$1" line
    value=""
    [[ -f "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -n "$line" && "$line" != \#* ]] || continue
        [[ -z "$value" && ! "$line" =~ [[:cntrl:]] ]] || return 1
        value="$line"
    done <"$file"
}
function pure_wrapper_option() {
    local key="$1" file="$2" flag type first second part
    pure_wrapper_value "$file" || return 1
    [[ -n "$value" ]] || return 0
    case "$key" in
        AllowAnonymousFXP) flag=-W type=boolean ;;
        AllowDotFiles) flag=-z type=boolean ;;
        AllowUserFXP) flag=-w type=boolean ;;
        AltLog) flag=-O type=string ;;
        AnonymousBandwidth) flag=-t type=number12 ;;
        AnonymousCanCreateDirs) flag=-M type=boolean ;;
        AnonymousCantUpload) flag=-i type=boolean ;;
        AnonymousOnly) flag=-e type=boolean ;;
        AnonymousRatio) flag=-q type=number2 ;;
        AntiWarez) flag=-s type=boolean ;;
        AutoRename) flag=-r type=boolean ;;
        Bind) flag=-S type=string ;;
        BrokenClientsCompatibility) flag=-b type=boolean ;;
        CallUploadScript) flag=-o type=boolean ;;
        ChrootEveryone) flag=-A type=boolean ;;
        CreateHomeDir) flag=-j type=boolean ;;
        CustomerProof) flag=-Z type=boolean ;;
        Daemonize) flag=-B type=boolean ;;
        DisplayDotFiles) flag=-D type=boolean ;;
        DontResolve) flag=-H type=boolean ;;
        ForcePassiveIP) flag=-P type=string ;;
        FortunesFile) flag=-F type=file ;;
        FSCharset) flag=-8 type=skip ;;
        ClientCharset) flag=-9 type=skip ;;
        IPV4Only) flag=-4 type=boolean ;;
        IPV6Only) flag=-6 type=boolean ;;
        KeepAllFiles) flag=-K type=boolean ;;
        LimitRecursion) flag=-L type=unlimited ;;
        LogPID) flag=-1 type=boolean ;;
        MaxClientsNumber) flag=-c type=number ;;
        MaxClientsPerIP) flag=-C type=number ;;
        MaxDiskUsage) flag=-k type=number ;;
        MaxIdleTime) flag=-I type=number ;;
        MaxLoad) flag=-m type=number ;;
        MinUID) flag=-u type=number ;;
        NATmode) flag=-N type=boolean ;;
        NoAnonymous) flag=-E type=boolean ;;
        NoChmod) flag=-R type=boolean ;;
        NoRename) flag=-G type=boolean ;;
        NoTruncate) flag=-0 type=boolean ;;
        PassivePortRange) flag=-p type=number2 ;;
        PerUserLimits) flag=-y type=number2 ;;
        ProhibitDotFilesRead) flag=-X type=boolean ;;
        ProhibitDotFilesWrite) flag=-x type=boolean ;;
        Quota) flag=-n type=number2 ;;
        SyslogFacility) flag=-f type=word ;;
        TLS) flag=-Y type=number ;;
        TLSCipherSuite) flag=-J type=string ;;
        TrustedGID) flag=-a type=number ;;
        TrustedIP) flag=-V type=ip ;;
        Umask) flag=-U type=umask ;;
        UserBandwidth) flag=-T type=number12 ;;
        UserRatio) flag=-Q type=number2 ;;
        VerboseLog) flag=-d type=boolean ;;
        ExtAuth) flag=extauth type=socket ;;
        LDAPConfigFile) flag=ldap type=file ;;
        MySQLConfigFile) flag=mysql type=file ;;
        PGSQLConfigFile) flag=pgsql type=file ;;
        PAMAuthentication) flag=pam type=boolean ;;
        PureDB) flag=puredb type=file ;;
        UnixAuthentication) flag=unix type=boolean ;;
        *)
            echo 'Unsupported Pure-FTPd configuration directive.' >&2
            return 1
            ;;
    esac
    case "$type" in
        boolean)
            case "${value,,}" in yes | 1 | on) value="" ;; no | 0 | off) return 0 ;; *) return 1 ;; esac
            ;;
        number) [[ "$value" =~ ^[0-9]+$ ]] || return 1 ;;
        number2 | unlimited | umask)
            [[ "$value" =~ ^(-?[0-9]+)[[:space:]]+(-?[0-9]+)$ ]] || return 1
            first="${BASH_REMATCH[1]}" second="${BASH_REMATCH[2]}"
            if [[ "$type" == umask ]]; then
                [[ "$first" =~ ^[0-7]{3}$ && "$second" =~ ^[0-7]{3}$ ]] || return 1
            elif [[ "$type" == unlimited ]]; then
                [[ "$first" != -* || "$first" == -1 ]] && [[ "$second" != -* || "$second" == -1 ]] || return 1
            else [[ "$first" != -* && "$second" != -* ]] || return 1; fi
            value="$first:$second"
            ;;
        number12)
            [[ "$value" =~ ^([0-9]+)[[:space:]:]+([0-9]+)$ ]] && value="${BASH_REMATCH[1]}:${BASH_REMATCH[2]}"
            [[ "$value" =~ ^:?[0-9]+(:[0-9]*)?$ ]] || return 1
            ;;
        file) [[ -f "$value" ]] || return 1 ;;
        socket) [[ -S "$value" ]] || return 1 ;;
        word) [[ "$value" =~ ^[A-Za-z0-9_]+$ ]] || return 1 ;;
        string) [[ ! "$value" =~ [[:space:]] ]] || return 1 ;;
        ip)
            [[ "$value" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
            IFS=. read -r -a ip_parts <<<"$value"
            for part in "${ip_parts[@]}"; do ((10#$part <= 255)) || return 1; done
            ;;
        skip) return 0 ;;
    esac
    if [[ "$flag" == extauth || "$flag" == ldap || "$flag" == mysql || "$flag" == pgsql || "$flag" == puredb ]]; then
        options+=(-l "$flag:$value")
    elif [[ "$flag" == pam || "$flag" == unix ]]; then
        options+=(-l "$flag")
    else
        options+=("$flag")
        [[ "$type" == boolean ]] || options+=("$value")
    fi
}
function pure_wrapper_main() {
    local root="${LEMPER_PUREFTPD_ROOT:-}" daemon=/usr/sbin/pure-ftpd show=false key file value capability="" authkey
    local options=() ip_parts=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --show-options | -s) show=true ;;
            --help | -h)
                echo 'Usage: pure-ftpd-wrapper [--show-options] [mysql|postgresql|ldap]'
                return 0
                ;;
            mysql | postgresql | ldap)
                [[ -z "$capability" ]] || return 1
                capability="$1"
                ;;
            *) return 1 ;;
        esac
        shift
    done
    [[ -z "$root" || "$root" == /* ]] || return 1
    [[ -d "$root/etc/pure-ftpd/conf" && -d "$root/etc/pure-ftpd/auth" ]] || return 1
    [[ -z "$capability" ]] || daemon+="-$capability"
    if [[ -f "$root/etc/pure-ftpd/conf/SyslogFacility" ]]; then
        pure_wrapper_option SyslogFacility "$root/etc/pure-ftpd/conf/SyslogFacility" || return 1
    fi
    # Authentication links are ordered by their names, as in Debian's wrapper.
    for file in "$root"/etc/pure-ftpd/auth/*; do
        [[ -L "$file" && -f "$file" ]] || continue
        authkey=$(basename "$(readlink -f -- "$file")") || return 1
        case "$authkey" in
            LDAPConfigFile) [[ "$capability" == ldap ]] || continue ;;
            MySQLConfigFile) [[ "$capability" == mysql ]] || continue ;;
            PGSQLConfigFile) [[ "$capability" == postgresql ]] || continue ;;
            ExtAuth | PAMAuthentication | PureDB | UnixAuthentication) ;;
            *)
                echo 'Unsupported Pure-FTPd authentication link.' >&2
                return 1
                ;;
        esac
        pure_wrapper_option "$authkey" "$file" || return 1
    done
    for file in "$root"/etc/pure-ftpd/conf/*; do
        [[ -f "$file" ]] || continue
        key="${file##*/}"
        [[ "$key" =~ ^[A-Za-z][A-Za-z0-9]+$ ]] || continue
        case "$key" in SyslogFacility | LDAPConfigFile | MySQLConfigFile | PGSQLConfigFile | ExtAuth | PAMAuthentication | PureDB | UnixAuthentication) continue ;; esac
        pure_wrapper_option "$key" "$file" || {
            echo 'Invalid Pure-FTPd configuration (value omitted).' >&2
            return 1
        }
    done
    [[ "${STANDALONE_OR_INETD:-}" != standalone ]] || options+=(-B)
    options+=(-g /var/run/pure-ftpd/pure-ftpd.pid)
    if [[ "$show" == true ]]; then
        printf '%s\n' "${options[*]}"
        return
    fi
    exec "$daemon" "${options[@]}"
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then pure_wrapper_main "$@"; fi
