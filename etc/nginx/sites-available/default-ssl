server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    ## HTTP/3 (QUIC) is added by the installer when NGINX_HTTP3=true.
    #include /etc/nginx/includes/http3.conf;

    server_name localhost.localdomain;

    ## SSL configuration.
    ssl_certificate HOSTNAME_CERT_PATH/fullchain.pem;
    ssl_certificate_key HOSTNAME_CERT_PATH/privkey.pem;
    ssl_trusted_certificate HOSTNAME_CERT_PATH/fullchain.pem;
    include /etc/nginx/includes/ssl.conf;

    access_log /var/log/nginx/localhost.access.log lp_cache buffer=32k;
    error_log /var/log/nginx/localhost.error.log error;

    root /usr/share/nginx/html;
    index index.php index.html index.htm;
    client_max_body_size 50m;

    include /etc/nginx/includes/compression_gzip.conf;
    include /etc/nginx/includes/rules_security.conf;
    include /etc/nginx/includes/rules_restriction.conf;
    include /etc/nginx/includes/rules_staticfiles.conf;
    #include /etc/nginx/includes/rules_fastcgi_cache.conf;

    include /etc/nginx/vhost/site_default.conf;

    # PHP release used by handlers that do not pin a version.
    set $php_version "8.5";

    # Default and versioned PHP-FPM handlers.
    include /etc/nginx/includes/php_handlers.conf;

    # Local-only Nginx and PHP-FPM monitoring endpoints.
    include /etc/nginx/includes/monitoring.conf;

    #include /etc/nginx/includes/error_pages.conf;
    #include /etc/nginx/includes/fcgiwrap.conf;
}

## LEMPer Web-based Administration
server {
    listen 8083 ssl;
    listen [::]:8083 ssl;
    http2 on;

    server_name localhost.localdomain;

    ## SSL configuration.
    ssl_certificate HOSTNAME_CERT_PATH/fullchain.pem;
    ssl_certificate_key HOSTNAME_CERT_PATH/privkey.pem;
    ssl_trusted_certificate HOSTNAME_CERT_PATH/fullchain.pem;
    include /etc/nginx/includes/ssl.conf;

    root /usr/share/nginx/html;
    index index.php index.html index.htm;
    client_max_body_size 50m;

    # PHP release used by handlers that do not pin a version.
    set $php_version "8.5";

    # Apply the same hardening as the public vhosts.
    include /etc/nginx/includes/compression_gzip.conf;
    include /etc/nginx/includes/rules_security.conf;
    include /etc/nginx/includes/rules_restriction.conf;

    # Log Settings.
    access_log /var/log/nginx/localhost.access.log lp_cache buffer=32k;
    error_log /var/log/nginx/localhost.error.log error;

    location /lcp {
        try_files $uri $uri/ /index.php?$args;

        # Uncomment to enable naxsi WAF.
        #include /etc/nginx/includes/naxsi.rules;

        # Set basic auth.
        allow all;
        auth_basic "Denied";
        auth_basic_user_file /srv/.htpasswd;

        # Default and versioned handlers inherit this location's auth_basic.
        include /etc/nginx/includes/php_handlers.conf;
    }

    # Default and versioned PHP-FPM handlers.
    include /etc/nginx/includes/php_handlers.conf;

    #include /etc/nginx/includes/error_pages.conf;
    #include /etc/nginx/includes/fcgiwrap.conf;
}


## HTTP to HTTPS redirection.
server {
    listen 80;
    listen [::]:80;

    server_name localhost.localdomain;

    # Redirect all HTTP to HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 8082;
    listen [::]:8082;

    server_name localhost.localdomain;

    # Redirect admin panel to HTTPS
    location / {
        return 301 https://$server_name:8083$request_uri;
    }
}
