[Unit]
Description=LEMPer authenticated mail submission author policy
Before=postfix.service

[Service]
User=lemper-mail-author
Group=postfix
RuntimeDirectory=lemper-mail-author
RuntimeDirectoryMode=0700
CacheDirectory=lemper-mail-author
CacheDirectoryMode=0700
ExecStartPre=/usr/bin/rspamadm configtest -qs -c @ROOT@/submission-author.conf
ExecStart=/usr/bin/rspamd -f -c @ROOT@/submission-author.conf
# Cold starts can take longer while the worker initializes its filters.
# systemd enforces the deadline while submission waits for the policy socket.
TimeoutStartSec=90s
ExecStartPost=/bin/sh -c 'until test -S /var/spool/postfix/lemper-mail-author/filter.sock; do sleep 0.2; done'
ExecStopPost=/bin/rm -f /var/spool/postfix/lemper-mail-author/filter.sock
Restart=on-failure
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/spool/postfix/lemper-mail-author
UMask=0077

[Install]
WantedBy=multi-user.target
