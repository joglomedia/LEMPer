[Unit]
Description=Pure-FTPd FTP server (LEMPer Stack)
Documentation=https://www.pureftpd.org/project/pure-ftpd/
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/pure-ftpd-wrapper
RuntimeDirectory=pure-ftpd
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
